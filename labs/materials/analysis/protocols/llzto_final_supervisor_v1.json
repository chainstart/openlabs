  "failure_rules": {
    "upstream_terminal_failure": "Remain visibly blocked and require a separately fingerprinted intervention; do not reinterpret the failed gate.",
    "unresolved_transport": "Preserve the report and extend only the exact unresolved trajectory under a new protocol.",
    "sensitivity_failure": "Retain the physical sensitivity and narrow the claim under a new publication protocol; never relax the equivalence margin.",
    "analysis_failure": "Preserve logs and immutable partial outputs; repair under a new committed supervisor version rather than overwriting evidence.",
    "audit_failure": "Do not execute Q1-readiness scoring until every blocker is resolved and a newly generated audit passes."
  }
