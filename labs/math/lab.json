{
  "schema_version": "openlabs.lab.v1",
  "lab_id": "math",
  "domain": "math",
  "name": "OpenLabs Mathematics Lab",
  "runner": {
    "command": ["{python}", "../../packages/research-core/lab_runner.py"]
  },
  "worker_resources": {
    "cpu_burst_fraction_of_host": 0.75
  },
  "skills": [
    {
      "skill_id": "amra-research-loop",
      "path": "skills/amra-research-loop/SKILL.md"
    },
    {
      "skill_id": "math-production-supervisor",
      "path": "skills/math-production-supervisor/SKILL.md"
    },
    {
      "skill_id": "math-autonomous-research",
      "path": "skills/math-autonomous-research/SKILL.md"
    },
    {
      "skill_id": "open-math-research",
      "path": "skills/open-math-research/SKILL.md"
    },
    {
      "skill_id": "openlabs-math-paper",
      "path": "../../workflows/paper/skills/openlabs-math-paper/SKILL.md"
    },
    {
      "skill_id": "openlabs-paper-review",
      "path": "../../workflows/paper/skills/openlabs-paper-review/SKILL.md"
    }
  ],
  "protocols": [
    {
      "protocol_id": "amra-math",
      "primary_skill": "math-production-supervisor",
      "runtime_skills": [
        "math-production-supervisor",
        "amra-research-loop"
      ],
      "validator": {
        "command": [
          "{python}",
          "protocols/amra_math_protocol.py",
          "--project",
          "{project_config}",
          "--workstream",
          "{workstream_state}",
          "--mode",
          "{validation_mode}"
        ]
      }
    },
    {
      "protocol_id": "autonomous-math",
      "primary_skill": "math-autonomous-research",
      "runtime_skills": [
        "math-autonomous-research"
      ],
      "validator": {
        "command": [
          "{python}",
          "protocols/autonomous_math_protocol.py",
          "--project",
          "{project_config}",
          "--workstream",
          "{workstream_state}",
          "--mode",
          "{validation_mode}"
        ]
      }
    },
    {
      "protocol_id": "open-math-research",
      "primary_skill": "open-math-research",
      "runtime_skills": [
        "open-math-research"
      ],
      "validator": {
        "command": [
          "{python}",
          "protocols/autonomous_math_protocol.py",
          "--project",
          "{project_config}",
          "--workstream",
          "{workstream_state}",
          "--mode",
          "{validation_mode}",
          "--protocol-id",
          "open-math-research"
        ]
      }
    }
  ],
  "runtime_setup": [
    {
      "setup_id": "lean4-mathlib-v4.26.0",
      "command": [
        "{python}",
        "tools/formal/lean_runtime.py",
        "prepare",
        "--agent-workspace",
        "{agent_workspace}",
        "--artifacts-root",
        "{artifacts_root}"
      ],
      "timeout_seconds": 1800
    },
    {
      "setup_id": "sage-exact-v10.8",
      "command": [
        "{python}",
        "tools/computation/math_runtime.py",
        "prepare",
        "--profile",
        "sage-exact-v10.8",
        "--agent-workspace",
        "{agent_workspace}"
      ],
      "timeout_seconds": 120
    },
    {
      "setup_id": "arb-certified-v10.8",
      "command": [
        "{python}",
        "tools/computation/math_runtime.py",
        "prepare",
        "--profile",
        "arb-certified-v10.8",
        "--agent-workspace",
        "{agent_workspace}"
      ],
      "timeout_seconds": 120
    },
    {
      "setup_id": "smt-consensus-z3-cvc5-v1",
      "command": [
        "{python}",
        "tools/computation/math_runtime.py",
        "prepare",
        "--profile",
        "smt-consensus-z3-cvc5-v1",
        "--agent-workspace",
        "{agent_workspace}"
      ],
      "timeout_seconds": 120
    }
  ],
  "capabilities": [
    "open-problem-selection",
    "persistent-multi-agent-proof-search",
    "mechanism-falsification",
    "counterexample-search",
    "symbolic-computation",
    "sage-exact-computation",
    "arb-certified-numerics",
    "smt-solver-consensus",
    "lean-verification"
  ]
}
