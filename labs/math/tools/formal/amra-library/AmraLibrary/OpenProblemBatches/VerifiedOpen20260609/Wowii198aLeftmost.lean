          (y := w) (z := z) hwrs hwright hz)
    have hspliced_descent :
        terminalPathPairCommonCard spliced < terminalPathPairCommonCard pair := by
      exact hdirect
    exact ⟨spliced, hspliced_descent⟩
-/

