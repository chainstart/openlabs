        terminalPathPairWeightedMeasure swappedOriginal ≤
          terminalPathPairWeightedMeasure pair' := by
    intro pair'
    calc
      terminalPathPairWeightedMeasure swappedOriginal =
          terminalPathPairWeightedMeasure pair := by
        simpa [swappedOriginal] using terminalPathPairWeightedMeasure_swap pair
      _ ≤ terminalPathPairWeightedMeasure
          (((pair'.2, pair'.1) : G.Path v s × G.Path v t)) :=
        hpair_measure_min (pair'.2, pair'.1)
      _ = terminalPathPairWeightedMeasure pair' := by
        simpa using terminalPathPairWeightedMeasure_swap pair'
  have hobs_swap :
      terminalSetFanLeftBridgeFirstGuardRightPrefixObstruction
        (G := G) (v := v) (s := t) (t := s)
        swappedOriginal x hx_right hx_left := by
    rcases hobs with
      ⟨rt, hrtPath, hx_rt, w, hw_rt, hwv, hw_right,
        hx_not_prefix_right, y, hyv, hy_rt, hy_left, hy_not_right,
        hy_tail, hfirst_union, hy_suffix_x, q, hq_mid, hqv, hq_swap,
        hq_not_common, hfirst_bad, hq_left_prefix⟩
    exact ⟨rt, hrtPath, hx_rt, w, hw_rt, hwv, hw_right,
      hx_not_prefix_right, y, hyv, hy_rt, hy_left, hy_not_right,
      hy_tail, hfirst_union, hy_suffix_x, q, hq_mid, hqv,
      by simpa [swappedOriginal] using hq_swap,
      by simpa [swappedOriginal] using hq_not_common,
