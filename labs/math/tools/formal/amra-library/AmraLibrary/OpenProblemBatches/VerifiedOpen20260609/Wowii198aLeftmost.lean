        · rcases terminal_set_fan_left_suffix_stage_right_suffix_witness_commonCard_lt
            (G := G) (v := v) (s := s) (t := t)
            (x := x) (y := b) (a := aNext) (z := y)
            (r := r2) (pair := pair) (rs := rs)
