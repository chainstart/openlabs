          rcases terminal_set_fan_splice_descent_right_of_hsep_or_union_first_right_residual
              (G := G) (v := v) (s := s) (t := t) (x := x) (y := y)
              (pair := pair) (rt := rt) hsep hpair_measure_min hrtPath
              (by simpa [qsMin] using hxqs)
              (by simpa [qtMin] using hxqt) hxv hx_rt
              (by simpa [qsMin] using hyqs) hyrt hyv hyx with
            hdescent | hresidual
          · rcases hdescent with ⟨pair', hpair'_lt⟩
            exact False.elim (hpair_no_common_decrease pair' hpair'_lt)
