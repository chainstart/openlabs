lemma terminal_set_fan_right_first_crossing_uncrossing_commonCard_lt
    {α : Type*} [Fintype α] [DecidableEq α]
    {G : SimpleGraph α} {v s t x w : α}
    {pair : G.Path v s × G.Path v t}
    {rt : G.Walk v t}
    (hpair_measure_min : ∀ pair' : G.Path v s × G.Path v t,
      terminalPathPairWeightedMeasure pair ≤ terminalPathPairWeightedMeasure pair')
    (hrtPath : rt.IsPath)
    (hx_left : x ∈ (pair.1 : G.Walk v s).support)
    (hx_right : x ∈ (pair.2 : G.Walk v t).support)
    (hxv : x ≠ v)
    (hx_rt : x ∉ rt.support)
    (hw_rt : w ∈ rt.support)
    (hw_left : w ∈ (pair.1 : G.Walk v s).support)
    (hw_not_right : w ∉ (pair.2 : G.Walk v t).support)
    (hwv : w ≠ v)
    (hfirst :
      ∀ z, z ∈ rt.support → z ≠ v →
        z ∈ (pair.2 : G.Walk v t).support ∨
        z ∈ (pair.1 : G.Walk v s).support →
        z = w ∨ z ∉ (rt.takeUntil w hw_rt).support) :
    ∃ pair' : G.Path v s × G.Path v t,
      terminalPathPairCommonCard pair' < terminalPathPairCommonCard pair := by
  classical
  let swappedOriginal : G.Path v t × G.Path v s := (pair.2, pair.1)
  have hpair_measure_min_swap :
      ∀ pair' : G.Path v t × G.Path v s,
        terminalPathPairWeightedMeasure swappedOriginal ≤
          terminalPathPairWeightedMeasure pair' := by
    intro pair'
    calc
      terminalPathPairWeightedMeasure swappedOriginal =
          terminalPathPairWeightedMeasure pair := by
        simpa [swappedOriginal] using terminalPathPairWeightedMeasure_swap pair
      _ ≤ terminalPathPairWeightedMeasure
          (((pair'.2, pair'.1) : G.Path v s × G.Path v t)) :=
        hpair_measure_min (pair'.2, pair'.1)
      _ = terminalPathPairWeightedMeasure pair' := by
        simpa using terminalPathPairWeightedMeasure_swap pair'
  have hfirst_swap :
      ∀ z, z ∈ rt.support → z ≠ v →
        z ∈ (swappedOriginal.1 : G.Walk v t).support ∨
        z ∈ (swappedOriginal.2 : G.Walk v s).support →
        z = w ∨ z ∉ (rt.takeUntil w hw_rt).support := by
    intro z hzrt hzv hzold
