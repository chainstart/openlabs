private def terminalSetFanLeftBridgeFirstGuardRightPrefixObstruction
    {α : Type*} [DecidableEq α]
    {G : SimpleGraph α} {v s t : α}
    (pair : G.Path v s × G.Path v t) (x : α)
    (hx_left : x ∈ (pair.1 : G.Walk v s).support)
    (hx_right : x ∈ (pair.2 : G.Walk v t).support) : Prop :=
  ∃ rs : G.Walk v s, rs.IsPath ∧ x ∉ rs.support ∧
    ∃ w : α, ∃ hw : w ∈ rs.support,
      w ≠ v ∧
      (∃ hw_left : w ∈ (pair.1 : G.Walk v s).support,
        x ∉ ((pair.1 : G.Walk v s).takeUntil w hw_left).support ∧
        (∃ y : α,
          y ≠ v ∧
          y ∈ rs.support ∧
          y ∈ (pair.2 : G.Walk v t).support ∧
          y ∉ (pair.1 : G.Walk v s).support ∧
          (∃ hy_tail : y ∈ (rs.dropUntil w hw).support,
            (∀ z, z ∈ rs.support → z ≠ v →
              z ∈ (pair.1 : G.Walk v s).support ∨
              z ∈ (pair.2 : G.Walk v t).support →
              z ∈ (rs.takeUntil w hw).support → z = w) ∧
            y ∈ ((pair.2 : G.Walk v t).dropUntil x hx_right).support ∧
            (∃ q : α,
              ∃ hq_mid :
                q ∈ ((rs.dropUntil w hw).takeUntil y hy_tail).support,
                q ≠ v ∧
                q ∈
                  (((((pair.2 : G.Walk v t).takeUntil x hx_right).append
                    ((pair.1 : G.Walk v s).dropUntil x hx_left)).toPath) :
                      G.Walk v s).support ∧
                ¬ (q ∈ (pair.1 : G.Walk v s).support ∧
                  q ∈ (pair.2 : G.Walk v t).support) ∧
                (∀ r : α, r ≠ v →
                  r ∈
                    (((((pair.2 : G.Walk v t).takeUntil x hx_right).append
                      ((pair.1 : G.Walk v s).dropUntil x hx_left)).toPath) :
                        G.Walk v s).support →
                  ¬ (r ∈ (pair.1 : G.Walk v s).support ∧
                    r ∈ (pair.2 : G.Walk v t).support) →
                  r ∈
                    (((rs.dropUntil w hw).takeUntil y hy_tail).takeUntil q
                      hq_mid).support →
                  r = q) ∧
                q ∈ (pair.2 : G.Walk v t).support ∧
                q ∉ (pair.1 : G.Walk v s).support ∧
                q ∈ ((pair.2 : G.Walk v t).takeUntil x hx_right).support))))

private def terminalSetFanRightBridgeFirstGuardLeftPrefixObstruction
    {α : Type*} [DecidableEq α]
    {G : SimpleGraph α} {v s t : α}
    (pair : G.Path v s × G.Path v t) (x : α)
    (hx_left : x ∈ (pair.1 : G.Walk v s).support)
    (hx_right : x ∈ (pair.2 : G.Walk v t).support) : Prop :=
  ∃ rt : G.Walk v t, rt.IsPath ∧ x ∉ rt.support ∧
    ∃ w : α, ∃ hw : w ∈ rt.support,
      w ≠ v ∧
      (∃ hw_right : w ∈ (pair.2 : G.Walk v t).support,
        x ∉ ((pair.2 : G.Walk v t).takeUntil w hw_right).support ∧
        (∃ y : α,
          y ≠ v ∧
          y ∈ rt.support ∧
          y ∈ (pair.1 : G.Walk v s).support ∧
          y ∉ (pair.2 : G.Walk v t).support ∧
          (∃ hy_tail : y ∈ (rt.dropUntil w hw).support,
            (∀ z, z ∈ rt.support → z ≠ v →
              z ∈ (pair.2 : G.Walk v t).support ∨
              z ∈ (pair.1 : G.Walk v s).support →
              z ∈ (rt.takeUntil w hw).support → z = w) ∧
            y ∈ ((pair.1 : G.Walk v s).dropUntil x hx_left).support ∧
            (∃ q : α,
              ∃ hq_mid :
                q ∈ ((rt.dropUntil w hw).takeUntil y hy_tail).support,
                q ≠ v ∧
                q ∈
                  (((((pair.1 : G.Walk v s).takeUntil x hx_left).append
                    ((pair.2 : G.Walk v t).dropUntil x hx_right)).toPath) :
                      G.Walk v t).support ∧
                ¬ (q ∈ (pair.2 : G.Walk v t).support ∧
                  q ∈ (pair.1 : G.Walk v s).support) ∧
                (∀ r : α, r ≠ v →
                  r ∈
                    (((((pair.1 : G.Walk v s).takeUntil x hx_left).append
                      ((pair.2 : G.Walk v t).dropUntil x hx_right)).toPath) :
                        G.Walk v t).support →
                  ¬ (r ∈ (pair.2 : G.Walk v t).support ∧
                    r ∈ (pair.1 : G.Walk v s).support) →
                  r ∈
                    (((rt.dropUntil w hw).takeUntil y hy_tail).takeUntil q
                      hq_mid).support →
                  r = q) ∧
                q ∈ (pair.1 : G.Walk v s).support ∧
                q ∉ (pair.2 : G.Walk v t).support ∧
                q ∈ ((pair.1 : G.Walk v s).takeUntil x hx_left).support))))

lemma terminal_set_fan_left_reduced_first_guard_right_prefix_commonCard_lt
    {α : Type*} [Fintype α] [DecidableEq α]
    {G : SimpleGraph α} {v s t x y q : α}
    {pair : G.Path v s × G.Path v t}
    {rs : G.Walk v s}
    (hpair_measure_min : ∀ pair' : G.Path v s × G.Path v t,
      terminalPathPairWeightedMeasure pair ≤ terminalPathPairWeightedMeasure pair')
    (hrsPath : rs.IsPath)
    (hx_left : x ∈ (pair.1 : G.Walk v s).support)
    (hx_right : x ∈ (pair.2 : G.Walk v t).support)
    (hxv : x ≠ v)
    (hx_rs : x ∉ rs.support)
    (hy_rs : y ∈ rs.support)
    (hy_right : y ∈ (pair.2 : G.Walk v t).support)
    (hy_not_left : y ∉ (pair.1 : G.Walk v s).support)
    (hy_suffix_x :
      y ∈ ((pair.2 : G.Walk v t).dropUntil x hx_right).support)
    (hq_rs : q ∈ rs.support)
    (hqv : q ≠ v)
    (hq_swap :
      q ∈
        (((((pair.2 : G.Walk v t).takeUntil x hx_right).append
          ((pair.1 : G.Walk v s).dropUntil x hx_left)).toPath) :
            G.Walk v s).support)
    (hq_not_common :
      ¬ (q ∈ (pair.1 : G.Walk v s).support ∧
        q ∈ (pair.2 : G.Walk v t).support))
    (hq_right_prefix :
      q ∈ (pair.2 : G.Walk v t).support ∧
        q ∉ (pair.1 : G.Walk v s).support ∧
        q ∈ ((pair.2 : G.Walk v t).takeUntil x hx_right).support)
    (hq_prefix_y : q ∈ (rs.takeUntil y hy_rs).support) :
    ∃ pair' : G.Path v s × G.Path v t,
      terminalPathPairCommonCard pair' < terminalPathPairCommonCard pair := by
  classical
  have hno_lower :
      ∀ pair' : G.Path v s × G.Path v t,
        ¬ terminalPathPairCommonCard pair' < terminalPathPairCommonCard pair :=
    not_terminalPathPairCommonCard_lt_of_weighted_min hpair_measure_min
  have hyx : y ≠ x := by
    intro hyx_eq
    exact hx_rs (by simpa [hyx_eq] using hy_rs)
  let swapLeft : G.Path v s :=
    (((pair.2 : G.Walk v t).takeUntil x hx_right).append
      ((pair.1 : G.Walk v s).dropUntil x hx_left)).toPath
  have hy_not_swap :
      y ∉ (swapLeft : G.Walk v s).support := by
    intro hy_swap
    have hy_swap_raw :
        y ∈ (((pair.2 : G.Walk v t).takeUntil x hx_right).append
          ((pair.1 : G.Walk v s).dropUntil x hx_left)).support :=
      Walk.support_toPath_subset _ hy_swap
    rw [Walk.mem_support_append_iff] at hy_swap_raw
    rcases hy_swap_raw with hy_right_prefix | hy_left_suffix
    · exact
        (not_mem_dropUntil_of_mem_takeUntil_ne_on_isPath
          (G := G) (p := (pair.2 : G.Walk v t))
          pair.2.property hx_right hy_right hy_right_prefix hyx)
        hy_suffix_x
    · exact hy_not_left
        (Walk.support_dropUntil_subset (pair.1 : G.Walk v s)
          hx_left hy_left_suffix)
  let S : Finset α :=
    Finset.univ.filter fun a =>
      a ≠ v ∧
      a ∈ (swapLeft : G.Walk v s).support ∧
      ¬ (a ∈ (pair.1 : G.Walk v s).support ∧
        a ∈ (pair.2 : G.Walk v t).support) ∧
      a ∈ ((pair.2 : G.Walk v t).takeUntil x hx_right).support ∧
      a ∈ (rs.takeUntil y hy_rs).support
  have hright_prefix_front_successor :
      ∀ a : α, ∀ ha_rs : a ∈ rs.support, a ∈ S →
        ∃ aNext : α,
          aNext ∈ S ∧
          aNext ∈ (rs.dropUntil a ha_rs).support ∧
          aNext ≠ a := by
    intro a ha_rs haS
    have haS_data := (Finset.mem_filter.mp haS).2
    rcases haS_data with
      ⟨hav, ha_swap, ha_not_common, ha_prefix_x, ha_prefix_y⟩
    have ha_right : a ∈ (pair.2 : G.Walk v t).support :=
      Walk.support_takeUntil_subset (pair.2 : G.Walk v t) hx_right
        ha_prefix_x
    have ha_not_left : a ∉ (pair.1 : G.Walk v s).support := by
      intro ha_left
      exact ha_not_common ⟨ha_left, ha_right⟩
    have ha_ne_y : a ≠ y := by
      intro hay
      exact hy_not_swap (by simpa [swapLeft, hay] using ha_swap)
    have hy_tail_a : y ∈ (rs.dropUntil a ha_rs).support :=
      mem_dropUntil_of_mem_takeUntil_ne
        (G := G) rs ha_rs hy_rs ha_prefix_y ha_ne_y
    have hnot_segment_left_guard :
        ¬ ∀ b : α, b ≠ v →
          b ∈ (pair.1 : G.Walk v s).support →
          b ∈ ((rs.dropUntil a ha_rs).takeUntil y
            hy_tail_a).support →
          b ∈ (pair.2 : G.Walk v t).support := by
      intro hguard
      rcases terminal_set_fan_bridge_right_prefix_stage_commonCard_lt
          (G := G) (v := v) (s := s) (t := t)
          (x := x) (a := a) (z := y)
          (pair := pair) (rs := rs)
          hx_left hx_right hxv hx_rs ha_right ha_rs hy_right hy_rs
          ha_prefix_x hy_suffix_x ha_prefix_y ha_ne_y hyx hguard with
        ⟨pair', hpair'_lt⟩
      exact hno_lower pair' hpair'_lt
    rcases exists_first_segment_left_only_of_not_segment_left_guard
        (G := G) (v := v) (s := s) (t := t)
        (a := a) (z := y) (pair := pair) (rs := rs)
        (ha_rs := ha_rs) (hz_tail := hy_tail_a)
        hnot_segment_left_guard with
      ⟨b, hb_mid, hbv, hb_left, hb_not_right, hb_first⟩
    have hb_tail_a : b ∈ (rs.dropUntil a ha_rs).support :=
      Walk.support_takeUntil_subset (rs.dropUntil a ha_rs)
        hy_tail_a hb_mid
    have hb_rs : b ∈ rs.support :=
      Walk.support_dropUntil_subset rs ha_rs hb_tail_a
    have hb_ne_a : b ≠ a := by
      intro hba
      exact ha_not_left (by simpa [hba] using hb_left)
    have ha_prefix_b : a ∈ (rs.takeUntil b hb_rs).support :=
      mem_takeUntil_of_mem_dropUntil_ne_on_isPath
        (G := G) (p := rs) hrsPath ha_rs hb_rs hb_tail_a
        hb_ne_a.symm
    have ha_not_tail_b : a ∉ (rs.dropUntil b hb_rs).support :=
      not_mem_dropUntil_of_mem_takeUntil_ne_on_isPath
        (G := G) (p := rs) hrsPath hb_rs ha_rs ha_prefix_b
        hb_ne_a.symm
    have hb_ne_y : b ≠ y := by
      intro hby
      exact hb_not_right (by simpa [hby] using hy_right)
    have hb_prefix_y : b ∈ (rs.takeUntil y hy_rs).support :=
      mem_takeUntil_of_mem_dropUntil_takeUntil_ne_on_isPath
        (G := G) (p := rs) hrsPath ha_rs hy_rs hy_tail_a
        hb_mid hb_ne_y
    have hy_tail_b : y ∈ (rs.dropUntil b hb_rs).support :=
      mem_dropUntil_of_mem_takeUntil_ne
        (G := G) rs hb_rs hy_rs hb_prefix_y hb_ne_y
    have hbx : b ≠ x := by
      intro hbx_eq
      exact hb_not_right (by simpa [hbx_eq] using hx_right)
    have hb_pos :=
      mem_takeUntil_or_mem_dropUntil_of_mem_support
        (G := G) (p := (pair.1 : G.Walk v s)) hx_left hb_left
    have hb_prefix_x :
        b ∈ ((pair.1 : G.Walk v s).takeUntil x hx_left).support := by
      rcases hb_pos with hb_prefix_x | hb_suffix_x
      · exact hb_prefix_x
      · rcases terminal_set_fan_right_prefix_stage_left_suffix_witness_commonCard_lt
          (G := G) (v := v) (s := s) (t := t)
          (x := x) (a := a) (z := y) (b := b)
          (pair := pair) (rs := rs)
          hx_left hx_right hxv hx_rs ha_right ha_not_left
          ha_rs ha_prefix_x hy_right hy_tail_a hy_suffix_x
          hb_mid hbv hb_left hb_not_right hb_first hb_suffix_x with
        ⟨pair', hpair'_lt⟩
        exact False.elim (hno_lower pair' hpair'_lt)
    have hb_alt :
        b ∈
          (((((pair.1 : G.Walk v s).takeUntil x hx_left).append
            ((pair.2 : G.Walk v t).dropUntil x hx_right)).toPath) :
              G.Walk v t).support := by
      by_contra hb_not_alt
      rcases terminal_set_cross_swap_commonCard_lt_of_left_prefix_absent_altRight
          (G := G) (v := v) (s := s) (t := t)
          (x := x) (y := b) (pair := pair)
          hx_left hx_right hxv hb_prefix_x hb_not_alt with
        ⟨pair', hpair'_lt⟩
      exact hno_lower pair' hpair'_lt
    have hnot_bridge_guard_by :
        ¬ ∀ q0 : α, q0 ≠ v →
          q0 ∈ (swapLeft : G.Walk v s).support →
          q0 ∈ ((rs.dropUntil b hb_rs).takeUntil y hy_tail_b).support →
          q0 ∈ (pair.1 : G.Walk v s).support ∧
            q0 ∈ (pair.2 : G.Walk v t).support := by
      intro hguard
      rcases terminal_set_fan_two_sided_bridge_commonCard_lt_of_middle_guard
          (G := G) (v := v) (s := s) (t := t)
          (x := x) (y := b) (z := y)
          (pair := pair) (rs := rs)
