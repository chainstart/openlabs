      simpa [raw, leftPrefix, rightSuffix] using hx_after_c_raw
    have hx_after_c_rightSuffix :
        x ∈ (rightSuffix.dropUntil c
          (by simpa [rightSuffix] using hc_right_suffix)).support :=
      mem_dropUntil_append_right_of_pivot_not_left
        (G := G) leftPrefix rightSuffix
        (by simpa [rightSuffix] using hc_right_suffix)
        hc_not_leftPrefix hx_after_c_raw'
    have hc_right : c ∈ (pair.2 : G.Walk v t).support :=
      Walk.support_dropUntil_subset (pair.2 : G.Walk v t) hx_right
        hc_right_suffix
    have hx_after_c_right :
        x ∈ ((pair.2 : G.Walk v t).dropUntil c hc_right).support :=
      mem_dropUntil_of_mem_nested_dropUntil
        (G := G) (p := (pair.2 : G.Walk v t)) pair.2.property
        hx_right hc_right_suffix
        (by simpa [rightSuffix] using hx_after_c_rightSuffix)
    exact
      not_both_mem_dropUntil_on_simple_path
        (G := G) (p := (pair.2 : G.Walk v t)) pair.2.property
        hx_right hc_right hx_after_c_right hc_right_suffix
        (fun hxc => hcx hxc.symm)

