              (G := G) (v := v) (s := s) (t := t)
              (x := x) (y := b) (a := aNext)
              (pair := pair) (rs := rs)
              hx_left hx_right hxv hx_rs hb_left hb_rs
              hleft.1 haNext_rs haNext_tail_b
              hb_prefix_x hleft.2.2 hbx hguard with
