          (((((pair.2 : G.Walk v t).takeUntil x hx_right).append
            ((pair.1 : G.Walk v s).dropUntil x hx_left)).toPath) :
              G.Walk v s).support →
        ¬ (r ∈ (pair.1 : G.Walk v s).support ∧
          r ∈ (pair.2 : G.Walk v t).support) →
