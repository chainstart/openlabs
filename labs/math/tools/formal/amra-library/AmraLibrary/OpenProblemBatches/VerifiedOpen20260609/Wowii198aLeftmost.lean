      let altRight : G.Path v t :=
        (((pair.1 : G.Walk v s).takeUntil x hx_left).append
          ((pair.2 : G.Walk v t).dropUntil x hx_right)).toPath
      ∀ y : α, y ≠ v →
        y ∈ (altRight : G.Walk v t).support →
