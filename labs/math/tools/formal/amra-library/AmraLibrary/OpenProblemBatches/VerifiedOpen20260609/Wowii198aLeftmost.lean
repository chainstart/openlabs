          y ≠ v ∧
          y ∈ rs.support ∧
          y ∈ (pair.2 : G.Walk v t).support ∧
          y ∉ (pair.1 : G.Walk v s).support ∧
          y ∈ (rs.dropUntil w hw).support ∧
          ∀ z, z ∈ rs.support → z ≠ v →
            z ∈ (pair.1 : G.Walk v s).support ∨
            z ∈ (pair.2 : G.Walk v t).support →
            z ∈ (rs.takeUntil w hw).support → z = w) := by
  classical
  rcases exists_new_left_replacement_intersection_of_not_commonCard_lt
      (G := G) (v := v) (s := s) (t := t) (x := x)
      (pair := pair) (rs := rs) hrsPath hx_left hx_right hxv hx_rs
      hdirect with
    ⟨y, hyv, hy_rs, hy_right, hy_not_left⟩
  rcases exists_first_nonapex_intersection_on_walk_pair_support
      (G := G) (v := v) (s := s) (t := t)
      (left := (pair.1 : G.Walk v s))
      (right := (pair.2 : G.Walk v t)) (r := rs)
      hy_rs hy_right hyv with
    ⟨w, hw_rs, hwv, hw_old, hfirst_union⟩
  have hfirst_union_rs :
      ∀ z, z ∈ rs.support → z ≠ v →
        z ∈ (pair.1 : G.Walk v s).support ∨
        z ∈ (pair.2 : G.Walk v t).support →
        z ∈ (rs.takeUntil w hw_rs).support → z = w := by
    intro z _hz_rs hzv hz_old hz_prefix
    exact hfirst_union z hzv hz_old hz_prefix
  by_cases hw_left : w ∈ (pair.1 : G.Walk v s).support
  · right
    have hy_not_prefix : y ∉ (rs.takeUntil w hw_rs).support := by
      intro hy_prefix
      have hy_eq_w : y = w :=
        hfirst_union y hyv (Or.inr hy_right) hy_prefix
      exact hy_not_left (by simpa [hy_eq_w] using hw_left)
    have hy_tail : y ∈ (rs.dropUntil w hw_rs).support :=
      mem_dropUntil_of_mem_support_not_takeUntil
        (G := G) rs hw_rs hy_rs hy_not_prefix
    exact ⟨w, hw_rs, hwv, hw_left,
      y, hyv, hy_rs, hy_right, hy_not_left, hy_tail, hfirst_union_rs⟩
  · have hw_right : w ∈ (pair.2 : G.Walk v t).support := by
      rcases hw_old with hw_left' | hw_right
      · exact False.elim (hw_left hw_left')
      · exact hw_right
    left
    exact terminal_set_fan_splice_descent_left_of_hsep_of_union_first_right
      (G := G) (v := v) (s := s) (t := t) (x := x) (w := w)
      (pair := pair) (rs := rs)
