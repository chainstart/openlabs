    intro hzx_eq
    exact hx_rs (by simpa [hzx_eq] using hzrs)
  have hz_alt_raw :
      z ∈ (((pair.1 : G.Walk v s).takeUntil x hx_left).append
        ((pair.2 : G.Walk v t).dropUntil x hx_right)).support := by
