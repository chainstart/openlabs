    (hright : G.Adj (p.getVert (j - 1)) (p.getVert (j + 1))) :
    False := by
  rcases gap_four_left_middle_escape_connector_exists
      (G := G) (p := p) hpPath hv hi_pos hgap_eq hj_lt hvi hvj
