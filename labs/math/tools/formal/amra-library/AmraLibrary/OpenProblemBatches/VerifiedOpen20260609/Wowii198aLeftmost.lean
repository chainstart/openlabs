    (hy_rs : y ∈ rs.support)
    (hy_prefix_z : y ∈ (rs.takeUntil z hzrs).support)
    (hy_left : y ∈ (pair.1 : G.Walk v s).support)
    (_hy_not_right : y ∉ (pair.2 : G.Walk v t).support)
