            hr2_not_left hr2_suffix_x haNext_first with
          ⟨pair', hpair'_lt⟩
          exact False.elim (hno_lower pair' hpair'_lt)
    have haNextS : aNext ∈ S := by
      change aNext ∈ Finset.univ.filter (fun a =>
        a ≠ v ∧
        a ∈ (swapLeft : G.Walk v s).support ∧
        ¬ (a ∈ (pair.1 : G.Walk v s).support ∧
          a ∈ (pair.2 : G.Walk v t).support) ∧
        a ∈ ((pair.2 : G.Walk v t).takeUntil x hx_right).support ∧
        a ∈ (rs.takeUntil y hy_rs).support)
      rw [Finset.mem_filter]
      exact
        ⟨by simp, haNext_v, by simpa [swapLeft] using haNext_swap,
          haNext_not_common, haNext_right_prefix.2.2,
          haNext_prefix_y⟩
    exact ⟨aNext, haNextS, haNext_tail_a, haNext_ne_a⟩
  have hqS : q ∈ S := by
    change q ∈ Finset.univ.filter (fun a =>
      a ≠ v ∧
      a ∈ (swapLeft : G.Walk v s).support ∧
      ¬ (a ∈ (pair.1 : G.Walk v s).support ∧
        a ∈ (pair.2 : G.Walk v t).support) ∧
      a ∈ ((pair.2 : G.Walk v t).takeUntil x hx_right).support ∧
