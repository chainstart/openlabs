    simpa [leftPrefix] using leftPrefix.end_mem_support
  have hx_alt : x ∈ (altRight : G.Walk v t).support := by
    simpa [altRight, raw, leftPrefix, rightSuffix] using
      (left_prefix_mem_altRight_of_weighted_min
        (G := G) (v := v) (s := s) (t := t)
        (x := x) (z := x) (pair := pair)
        hpair_measure_min hx_left hx_right hxv
        (by simpa [leftPrefix] using hx_prefix_left))
  by_cases hx_prefix_c :
      x ∈ ((altRight : G.Walk v t).takeUntil c hc_alt').support
  · exact Or.inl hx_prefix_c
  · right
    refine ⟨by simpa [altRight, raw, leftPrefix, rightSuffix] using hx_prefix_c, ?_⟩
    by_contra hc_not_leftPrefix
    have hx_after_c_alt :
        x ∈ ((altRight : G.Walk v t).dropUntil c hc_alt').support :=
      mem_dropUntil_of_mem_support_not_takeUntil
