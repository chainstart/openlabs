    (hx_right : x ∈ (pair.2 : G.Walk v t).support)
    (hxv : x ≠ v)
    (hx_rs : x ∉ rs.support)
    (hw_rs : w ∈ rs.support)
    (hw_right : w ∈ (pair.2 : G.Walk v t).support)
    (hw_not_left : w ∉ (pair.1 : G.Walk v s).support)
