    (hrsPath : rs.IsPath)
    (hx_left : x ∈ (pair.1 : G.Walk v s).support)
    (hx_right : x ∈ (pair.2 : G.Walk v t).support)
    (hxv : x ≠ v)
    (hx_rs : x ∉ rs.support)
    (_hyrs : y ∈ rs.support)
    (_hy_right : y ∈ (pair.2 : G.Walk v t).support)
