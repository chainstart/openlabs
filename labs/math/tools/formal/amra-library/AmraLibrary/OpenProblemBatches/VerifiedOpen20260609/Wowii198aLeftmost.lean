  dsimp at hbad_exists
  rcases exists_first_bad_pivot_on_rs
      (G := G) (v := v) (s := s) (t := t)
      (x := x) (pair := pair) (rs := rs)
      hx_left hx_right hbad_exists with
    ⟨z0, hz0rs, hz0v, hz0_alt, hz0_bad, hfirst_bad⟩
  have hz0_old_union :
