    {alpha : Type*} [Fintype alpha] [DecidableEq alpha] [Nontrivial alpha]
    {G : SimpleGraph alpha}
    (hconn : G.Connected)
    (hdelete : ∀ x : alpha,
      ((⊤ : G.Subgraph).deleteVerts ({x} : Set alpha)).Connected)
    {a b v : alpha} (p : G.Walk a b)
