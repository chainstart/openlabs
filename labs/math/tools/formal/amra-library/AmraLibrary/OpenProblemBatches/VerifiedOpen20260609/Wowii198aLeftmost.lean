      simpa [altRight, Walk.toPath] using hx_after_c_alt
    have hx_after_c_raw :
        x ∈ (raw.dropUntil c
          (Walk.support_bypass_subset raw hc_bypass)).support :=
      mem_dropUntil_of_mem_bypass_dropUntil
