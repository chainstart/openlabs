                (Walk.isSubwalk_dropUntil (pair.2 : G.Walk v t) hx_right)
                pair.2.property
            have hr_ne_x : r ≠ x := by
              intro hrx
              generalize hqeq :
                (pair.2 : G.Walk v t).dropUntil x hx_right = q
              have hqPath : q.IsPath := by
                simpa [hqeq] using hright_suffix_path
              have hx_not_tail : x ∉ q.support.tail := by
                cases q with
