lemma terminal_set_fan_splice_descent_right_reduction_of_not_direct
    {α : Type*} [Fintype α] [DecidableEq α]
    {G : SimpleGraph α} {v s t x : α}
    {pair : G.Path v s × G.Path v t}
    {rt : G.Walk v t}
    (hpair_measure_min : ∀ pair' : G.Path v s × G.Path v t,
