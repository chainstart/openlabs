    (_hrsPath : rs.IsPath)
    (hx_left : x ∈ (pair.1 : G.Walk v s).support)
    (hx_right : x ∈ (pair.2 : G.Walk v t).support)
    (hxv : x ≠ v)
    (hx_rs : x ∉ rs.support)
    (hzrs : z ∈ rs.support)
    (hz_right : z ∈ (pair.2 : G.Walk v t).support)
    (hz_not_left : z ∉ (pair.1 : G.Walk v s).support)
    (hz_suffix_right :
      z ∈ ((pair.2 : G.Walk v t).dropUntil x hx_right).support)
