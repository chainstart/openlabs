      terminalPathPairWeightedMeasure (G := G) pair' ≤
        terminalPathPairWeightedMeasure (G := G) pair) :
    terminalPathPairWeightedMeasureMinimal (G := G) pair' := by
  intro pair''
  exact le_trans hle (hmin pair'')

