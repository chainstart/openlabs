        (∃ y : α,
          y ≠ v ∧
          y ∈ rt.support ∧
          y ∈ (pair.1 : G.Walk v s).support ∧
          y ∉ (pair.2 : G.Walk v t).support ∧
          y ∈ (rt.dropUntil w hw).support ∧
          ∀ z, z ∈ rt.support → z ≠ v →
            z ∈ (pair.2 : G.Walk v t).support ∨
            z ∈ (pair.1 : G.Walk v s).support →
            z ∈ (rt.takeUntil w hw).support → z = w) := by
  classical
  rcases exists_new_right_replacement_intersection_of_not_commonCard_lt
      (G := G) (v := v) (s := s) (t := t) (x := x)
      (pair := pair) (rt := rt) hrtPath hx_left hx_right hxv hx_rt
      hdirect with
    ⟨y, hyv, hy_left, hy_rt, hy_not_right⟩
  rcases exists_first_nonapex_intersection_on_walk_pair_support
      (G := G) (v := v) (s := t) (t := s)
      (left := (pair.2 : G.Walk v t))
      (right := (pair.1 : G.Walk v s)) (r := rt)
      hy_rt hy_left hyv with
    ⟨w, hw_rt, hwv, hw_old, hfirst_union⟩
  have hfirst_union_rt :
      ∀ z, z ∈ rt.support → z ≠ v →
        z ∈ (pair.2 : G.Walk v t).support ∨
        z ∈ (pair.1 : G.Walk v s).support →
        z ∈ (rt.takeUntil w hw_rt).support → z = w := by
    intro z _hz_rt hzv hz_old hz_prefix
    exact hfirst_union z hzv hz_old hz_prefix
  by_cases hw_on_right : w ∈ (pair.2 : G.Walk v t).support
  · right
    have hy_not_prefix : y ∉ (rt.takeUntil w hw_rt).support := by
      intro hy_prefix
      have hy_eq_w : y = w :=
        hfirst_union y hyv (Or.inr hy_left) hy_prefix
      exact hy_not_right (by simpa [hy_eq_w] using hw_on_right)
    have hy_tail : y ∈ (rt.dropUntil w hw_rt).support :=
      mem_dropUntil_of_mem_support_not_takeUntil
        (G := G) rt hw_rt hy_rt hy_not_prefix
    exact ⟨w, hw_rt, hwv, hw_on_right,
      y, hyv, hy_rt, hy_left, hy_not_right, hy_tail, hfirst_union_rt⟩
  · have hw_left : w ∈ (pair.1 : G.Walk v s).support := by
      rcases hw_old with hw_right | hw_left
      · exact False.elim (hw_on_right hw_right)
      · exact hw_left
    left
    exact terminal_set_fan_splice_descent_right_of_hsep_of_union_first_left
      (G := G) (v := v) (s := s) (t := t) (x := x) (w := w)
