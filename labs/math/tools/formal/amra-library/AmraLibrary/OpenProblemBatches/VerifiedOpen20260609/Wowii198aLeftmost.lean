  intro hvs
  subst s
  have hnil : (pair.1 : G.Walk v v) = Walk.nil :=
    (Walk.isPath_iff_eq_nil _).mp pair.1.property
  have hx_eq : x = v := by
    simpa [hnil] using hx_left
