private lemma terminalPathPairLeftPrefixOnlyDefect_pos_first_cases
    {α : Type*} [Fintype α] [DecidableEq α]
    {G : SimpleGraph α} {v s t : α}
    {pair : G.Path v s × G.Path v t}
    (hpos : 0 < terminalPathPairLeftPrefixOnlyDefect (G := G) pair) :
    ∃ x : α, ∃ hx_left : x ∈ (pair.1 : G.Walk v s).support,
      x ∈ (pair.2 : G.Walk v t).support ∧
        ∃ z : α, ∃ hz_prefix :
          z ∈ ((pair.1 : G.Walk v s).takeUntil x hx_left).support,
            z ∉ (pair.2 : G.Walk v t).support ∧
              ∀ a : α,
                a ∈ ((pair.1 : G.Walk v s).takeUntil x hx_left).support →
                  a ∉ (pair.2 : G.Walk v t).support →
                    a ∈
                      (((pair.1 : G.Walk v s).takeUntil x hx_left).takeUntil
                        z hz_prefix).support →
                      a = z := by
  classical
  rcases terminalPathPairLeftPrefixOnlyDefect_pos_cases
      (G := G) (pair := pair) hpos with
    ⟨z0, x, hx_left, hx_right, hz0_prefix, hz0_not_right⟩
  let pref : G.Walk v x := (pair.1 : G.Walk v s).takeUntil x hx_left
  let S : Finset α :=
    pref.support.toFinset.filter fun a =>
      a ∉ (pair.2 : G.Walk v t).support
  have hz0S : z0 ∈ S := by
    dsimp [S]
    rw [Finset.mem_filter]
    exact ⟨by simpa [pref] using hz0_prefix, hz0_not_right⟩
  have hnonempty : {a ∈ S | a ∈ pref.support}.Nonempty := by
    refine ⟨z0, ?_⟩
    rw [Finset.mem_filter]
    exact ⟨hz0S, by simpa [pref] using hz0_prefix⟩
  rcases exists_first_mem_support_forall_mem_takeUntil_imp_eq
      (G := G) pref S hnonempty with
    ⟨z, hzS, hz_prefix, hfirst⟩
  have hz_not_right :
      z ∉ (pair.2 : G.Walk v t).support :=
    (Finset.mem_filter.mp hzS).2
  refine ⟨x, hx_left, hx_right, z, ?_, hz_not_right, ?_⟩
  · simpa [pref] using hz_prefix
  · intro a ha_prefix ha_not_right ha_take
    have haS : a ∈ S := by
      dsimp [S]
      rw [Finset.mem_filter]
      exact ⟨by simpa [pref] using ha_prefix, ha_not_right⟩
    exact hfirst a haS (by simpa [pref] using ha_take)

