        q ∈ (swappedOriginal.1 : G.Walk v t).support ∧
          q ∈ (swappedOriginal.2 : G.Walk v s).support := by
    intro q hqv hq_swap hq_mid
    simpa [swappedOriginal] using hmiddle_guard q hqv
      (by simpa [swappedOriginal] using hq_swap) hq_mid
