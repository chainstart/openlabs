  omega

private lemma support_length_toPath_le
    {α : Type*} {G : SimpleGraph α} {u v : α}
    (p : G.Walk u v) :
    (p.toPath : G.Walk u v).support.length ≤ p.support.length := by
  rw [Walk.length_support, Walk.length_support]
  exact Nat.succ_le_succ p.length_bypass_le

private lemma walk_support_length_le_of_toFinset_subset
    {α : Type*} [DecidableEq α]
    {G : SimpleGraph α} {u v u' v' : α}
    {p : G.Walk u v} {q : G.Walk u' v'}
    (hp : p.IsPath) (hq : q.IsPath)
    (hsub : p.support.toFinset ⊆ q.support.toFinset) :
    p.support.length ≤ q.support.length := by
  have hp_card : p.support.toFinset.card = p.support.length :=
    List.toFinset_card_of_nodup hp.support_nodup
  have hq_card : q.support.toFinset.card = q.support.length :=
    List.toFinset_card_of_nodup hq.support_nodup
  have hcard : p.support.toFinset.card ≤ q.support.toFinset.card :=
    Finset.card_le_card hsub
  omega

private lemma walk_support_length_le_of_toFinset_subset_insert_erase_mem
    {α : Type*} [DecidableEq α]
    {G : SimpleGraph α} {u v u' v' x y : α}
    {p : G.Walk u v} {q : G.Walk u' v'}
    (hp : p.IsPath) (hq : q.IsPath)
    (hsub : p.support.toFinset ⊆ insert y (q.support.toFinset.erase x))
    (hx : x ∈ q.support) :
    p.support.length ≤ q.support.length := by
  have hp_card : p.support.toFinset.card = p.support.length :=
    List.toFinset_card_of_nodup hp.support_nodup
  have hq_card : q.support.toFinset.card = q.support.length :=
    List.toFinset_card_of_nodup hq.support_nodup
  have hx_fin : x ∈ q.support.toFinset := by
    simpa using hx
  have hcard : p.support.toFinset.card ≤ q.support.toFinset.card :=
    card_le_of_subset_insert_erase_mem hsub hx_fin
  omega

private lemma walk_support_length_lt_of_toFinset_subset_erase_mem
    {α : Type*} [DecidableEq α]
    {G : SimpleGraph α} {u v u' v' x : α}
    {p : G.Walk u v} {q : G.Walk u' v'}
    (hp : p.IsPath) (hq : q.IsPath)
    (hsub : p.support.toFinset ⊆ q.support.toFinset.erase x)
    (hx : x ∈ q.support) :
    p.support.length < q.support.length := by
  have hp_card : p.support.toFinset.card = p.support.length :=
    List.toFinset_card_of_nodup hp.support_nodup
  have hq_card : q.support.toFinset.card = q.support.length :=
    List.toFinset_card_of_nodup hq.support_nodup
  have hx_fin : x ∈ q.support.toFinset := by
    simpa using hx
  have hcard_le :
      p.support.toFinset.card ≤ (q.support.toFinset.erase x).card :=
    Finset.card_le_card hsub
  have hcard_lt : (q.support.toFinset.erase x).card < q.support.toFinset.card :=
    Finset.card_erase_lt_of_mem hx_fin
  omega

private lemma walk_support_length_lt_of_toFinset_subset_insert_erase_inserted_mem
    {α : Type*} [DecidableEq α]
