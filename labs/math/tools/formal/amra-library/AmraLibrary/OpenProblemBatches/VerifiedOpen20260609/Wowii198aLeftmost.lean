private lemma takeUntil_support_length_le_two_of_forall_eq_start_or_front
    {α : Type*} [DecidableEq α]
    {G : SimpleGraph α} {v s w : α}
    {p : G.Walk v s}
    (hp : p.IsPath)
    (hw : w ∈ p.support)
    (hfront :
      ∀ z : α, z ∈ (p.takeUntil w hw).support → z = v ∨ z = w) :
    (p.takeUntil w hw).support.length ≤ 2 := by
  classical
  have hprefix_path : (p.takeUntil w hw).IsPath :=
    hp.takeUntil hw
  have hcard_eq :
      (p.takeUntil w hw).support.toFinset.card =
        (p.takeUntil w hw).support.length :=
    List.toFinset_card_of_nodup hprefix_path.support_nodup
  have hsub :
      (p.takeUntil w hw).support.toFinset ⊆ ({v, w} : Finset α) := by
    intro z hz
    rw [List.mem_toFinset] at hz
    rcases hfront z hz with hzv | hzw
    · rw [Finset.mem_insert]
      exact Or.inl hzv
    · rw [Finset.mem_insert, Finset.mem_singleton]
      exact Or.inr hzw
  have hcard_le :
      (p.takeUntil w hw).support.toFinset.card ≤ ({v, w} : Finset α).card :=
    Finset.card_le_card hsub
  have hpair_card_le : ({v, w} : Finset α).card ≤ 2 := by
    by_cases hvw : v = w
    · subst w
      simp
    · simp [hvw]
  omega

