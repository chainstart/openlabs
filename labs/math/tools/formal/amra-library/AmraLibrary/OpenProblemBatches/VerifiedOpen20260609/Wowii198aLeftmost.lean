        ⟨pair', hpair'_lt⟩
      exact hno_lower pair' hpair'_lt
    rcases exists_first_bridge_guard_counterexample
        (G := G) (v := v) (s := s) (t := t)
        (x := x) (y := b) (z := y)
        (pair := pair) (rs := rs)
        hx_left hx_right hb_rs hy_tail_b
        (by simpa [swapLeft] using hnot_bridge_guard_by) with
      ⟨aNext, haNext_mid, haNext_v, haNext_swap,
        haNext_not_common, haNext_first⟩
    have haNext_tail_b :
        aNext ∈ (rs.dropUntil b hb_rs).support :=
      Walk.support_takeUntil_subset (rs.dropUntil b hb_rs)
        hy_tail_b haNext_mid
    have haNext_rs : aNext ∈ rs.support :=
      Walk.support_dropUntil_subset rs hb_rs haNext_tail_b
    have haNext_ne_b : aNext ≠ b := by
      have hb_not_swap :
          b ∉ (swapLeft : G.Walk v s).support := by
        simpa [swapLeft] using
          (not_mem_cross_swap_left_of_left_prefix_not_right
            (G := G) (left := (pair.1 : G.Walk v s))
            (right := (pair.2 : G.Walk v t)) pair.1.property
            hx_left hx_right hb_left hb_prefix_x hb_not_right hbx)
      intro hab
      exact hb_not_swap (by simpa [hab] using haNext_swap)
    have haNext_ne_a : aNext ≠ a := by
      intro haa
      exact ha_not_tail_b (by simpa [haa] using haNext_tail_b)
    have haNext_tail_a :
        aNext ∈ (rs.dropUntil a ha_rs).support :=
      mem_dropUntil_of_mem_dropUntil_of_mem_dropUntil
        (G := G) (p := rs) hrsPath ha_rs hb_rs hb_tail_a
        haNext_tail_b
    have haNext_ne_y : aNext ≠ y := by
      intro hay
      exact hy_not_swap (by simpa [swapLeft, hay] using haNext_swap)
    have haNext_prefix_y :
        aNext ∈ (rs.takeUntil y hy_rs).support :=
      mem_takeUntil_of_mem_dropUntil_takeUntil_ne_on_isPath
        (G := G) (p := rs) hrsPath hb_rs hy_rs hy_tail_b
        haNext_mid haNext_ne_y
    have haNext_side :=
      bridge_guard_counterexample_side
        (G := G) (v := v) (s := s) (t := t)
        (x := x) (q := aNext) (pair := pair)
        hx_left hx_right (by simpa [swapLeft] using haNext_swap)
        haNext_not_common
    have haNext_right_prefix :
        aNext ∈ (pair.2 : G.Walk v t).support ∧
          aNext ∉ (pair.1 : G.Walk v s).support ∧
          aNext ∈ ((pair.2 : G.Walk v t).takeUntil x hx_right).support := by
      rcases haNext_side with hright | hleft
      · exact hright
      · have hnot_segment_right_guard :
            ¬ ∀ r : α, r ≠ v →
              r ∈ (pair.2 : G.Walk v t).support →
