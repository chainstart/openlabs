{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlabs.local/schemas/openlabs.lean_verification.v1.schema.json",
  "title": "OpenLabs Lean verification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "profile_id",
    "toolchain",
    "lean_version",
    "mathlib_revision",
    "main_source",
    "inputs",
    "declarations",
    "allowed_axioms",
    "observed_axioms",
    "command",
    "profile_sha256",
    "runtime_sha256",
    "resource_limits",
    "stdout_sha256",
    "stderr_sha256",
    "verified_at"
  ],
  "properties": {
    "schema_version": {"const": "openlabs.lean_verification.v1"},
    "status": {"const": "passed"},
    "profile_id": {"type": "string", "minLength": 1},
    "toolchain": {"type": "string", "minLength": 1},
    "lean_version": {"type": "string", "minLength": 1},
    "mathlib_revision": {"type": "string", "minLength": 1},
    "main_source": {"type": "string", "pattern": "(^|/)formal/lean/.+\\.lean$"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "declarations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_axioms": {"type": "array", "items": {"type": "string"}},
    "observed_axioms": {"type": "array", "items": {"type": "string"}},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_config_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_mib",
        "cpu_seconds",
        "wall_seconds",
        "file_mib",
        "open_files",
        "threads",
        "output_mib",
        "address_space_mib",
        "processes"
      ],
      "properties": {
        "memory_mib": {"type": "integer", "minimum": 1},
        "cpu_seconds": {"type": "integer", "minimum": 1},
        "wall_seconds": {"type": "integer", "minimum": 1},
        "file_mib": {"type": "integer", "minimum": 1},
        "open_files": {"type": "integer", "minimum": 1},
        "threads": {"type": "integer", "minimum": 1},
        "output_mib": {"type": "integer", "minimum": 1},
        "address_space_mib": {"type": "integer", "minimum": 1},
        "processes": {"type": "integer", "minimum": 1}
      }
    },
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verified_at": {"type": "string", "minLength": 1}
  }
}
