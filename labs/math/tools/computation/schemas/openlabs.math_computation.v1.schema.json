{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlabs.local/schemas/openlabs.math_computation.v1.schema.json",
  "title": "OpenLabs replayable mathematics computation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "profile_id",
    "evidence_class",
    "source",
    "inputs",
    "engines",
    "result",
    "command",
    "profile_sha256",
    "prepared_runtime_sha256",
    "resource_limits",
    "verified_at"
  ],
  "properties": {
    "schema_version": {"const": "openlabs.math_computation.v1"},
    "status": {"const": "passed"},
    "profile_id": {"type": "string", "minLength": 1},
    "evidence_class": {
      "enum": [
        "exact_symbolic_computation",
        "certified_ball_arithmetic",
        "finite_constraint_solver_consensus"
      ]
    },
    "source": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "engines": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "result": {"type": "object"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prepared_runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_mib",
        "cpu_seconds",
        "wall_seconds",
        "file_mib",
        "open_files",
        "threads",
        "output_mib",
        "address_space_mib",
        "processes"
      ],
      "properties": {
        "memory_mib": {"type": "integer", "minimum": 1},
        "cpu_seconds": {"type": "integer", "minimum": 1},
        "wall_seconds": {"type": "integer", "minimum": 1},
        "file_mib": {"type": "integer", "minimum": 1},
        "open_files": {"type": "integer", "minimum": 1},
        "threads": {"type": "integer", "minimum": 1},
        "output_mib": {"type": "integer", "minimum": 1},
        "address_space_mib": {"type": "integer", "minimum": 1},
        "processes": {"type": "integer", "minimum": 1}
      }
    },
    "verified_at": {"type": "string", "minLength": 1}
  }
}
