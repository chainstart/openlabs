[Unit]
Description=OpenLabs aggregate research worker resource guard
Before=openlabs-workers.target

[Slice]
CPUAccounting=yes
# This workstation exposes 20 logical CPUs. Keep 25% for the desktop and
# interactive work. bin/install-resource-guard recalculates this value when
# the slice is installed on a host with a different CPU count.
CPUQuota=1500%
MemoryAccounting=yes
MemoryHigh=30G
MemoryMax=34G
MemorySwapMax=4G
TasksAccounting=yes
TasksMax=512
