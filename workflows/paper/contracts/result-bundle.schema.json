{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chainstart/ara-paper-writing/contracts/result-bundle.schema.json",
  "title": "ARA Result Bundle",
  "type": "object",
  "required": ["schema_version", "bundle_id", "producer", "artifacts", "claims_file"],
  "properties": {
    "schema_version": {"const": "ara.result_bundle.v1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "claims_file": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        }
      }
    }
  }
}
