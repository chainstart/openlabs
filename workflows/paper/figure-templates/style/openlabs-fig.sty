% openlabs-fig.sty -- shared TikZ styles for OpenLabs manuscript schematics.
%
% Loaded automatically by `paper-writing figures build` for .tex figure sources.
% Works with pdflatex and lualatex. Options: sans (default: TeX Gyre Heros, a
% Helvetica-like face that matches the matplotlib style sheet), serif (keep the
% Latin Modern text face of a Computer Modern manuscript).
%
% Colours are the Okabe-Ito colour-blind-safe set, ordered so that the first four
% also differ in grey value (CIE L* 46 / 71 / 32 / 58); never let colour be the
% only cue for a category -- add a label, a pattern (ol/hatch) or a line style.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{openlabs-fig}[2026/11/20 OpenLabs shared figure styles]

\newif\ifolfig@serif
\DeclareOption{serif}{\olfig@seriftrue}
\DeclareOption{sans}{\olfig@seriffalse}
\ProcessOptions\relax

\RequirePackage{iftex}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds,shapes.geometric,
  shapes.misc,shapes.arrows,decorations.pathreplacing,decorations.markings,patterns,matrix,shadows,patterns.meta}

% ---------------------------------------------------------------- fonts
\ifolfig@serif\else
  \iftutex
    \RequirePackage{fontspec}
    \setsansfont{TeX Gyre Heros}[Scale=0.95]
  \else
    \RequirePackage[T1]{fontenc}
    \RequirePackage[scale=0.95]{tgheros}
  \fi
  \renewcommand{\familydefault}{\sfdefault}
\fi
% Design every figure at its final printed width: body text 8 pt, small 7 pt,
% never below 6 pt (`figures check` measures this after scaling).
\newcommand{\olfigfont}{\fontsize{8}{9.6}\selectfont}
\newcommand{\olfigsmall}{\fontsize{7}{8.4}\selectfont}
\newcommand{\olfigtiny}{\fontsize{6.5}{7.6}\selectfont}
% sample sizes and counts in text figures: \olN{4\,812} -> n = 4 812
\newcommand{\olN}[1]{\textit{n}\,=\,#1}
\newcommand{\olstep}[1]{\tikz[baseline=(olstep.base)]\node[ol/badge](olstep){#1};}
\newcommand{\olfigtitle}{\fontsize{8.5}{10}\selectfont\bfseries}

% ---------------------------------------------------------------- widths
\newlength{\olSingleColumn}\setlength{\olSingleColumn}{88mm}
\newlength{\olOneHalfColumn}\setlength{\olOneHalfColumn}{120mm}
\newlength{\olDoubleColumn}\setlength{\olDoubleColumn}{180mm}

% ---------------------------------------------------------------- colours
\definecolor{olBlue}{HTML}{0072B2}
\definecolor{olOrange}{HTML}{E69F00}
\definecolor{olWine}{HTML}{882255}
\definecolor{olGreen}{HTML}{009E73}
\definecolor{olSky}{HTML}{56B4E9}
\definecolor{olVermilion}{HTML}{D55E00}
\definecolor{olPurple}{HTML}{CC79A7}
\definecolor{olYellow}{HTML}{F0E442}
\definecolor{olInk}{HTML}{222222}
\definecolor{olGray}{HTML}{666666}
\definecolor{olLight}{HTML}{E4E4E4}
\definecolor{olPaper}{HTML}{F5F5F5}

% ---------------------------------------------------------------- styles
\tikzset{
  every picture/.append style={font=\olfigfont, line join=round, line cap=round,
    >={Stealth[length=2.2mm,width=1.7mm]}},
  % no hyphenation inside figure text: a broken word in a box reads as a typo
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000
    \thickmuskip=5mu\medmuskip=4mu\thinmuskip=3mu}},% rigid maths spacing in ragged boxes
  % a numbered step badge inline in text: \olstep{2}
  % boxes -------------------------------------------------------------
  ol/box/.style={draw=olInk, line width=0.6pt, rounded corners=1.6pt, fill=white,
    inner xsep=3.2pt, inner ysep=2.6pt, align=center, minimum height=6.5mm},
  ol/process/.style={ol/box, draw=#1!75!black, fill=#1!13},
  ol/process/.default=olBlue,
  ol/strong/.style={ol/box, draw=#1!80!black, fill=#1!32, font=\olfigfont\bfseries},
  ol/strong/.default=olBlue,
  ol/data/.style={ol/box, draw=#1!75!black, fill=#1!13, rounded corners=0.8pt,
    double copy shadow={shadow xshift=1.1pt, shadow yshift=-1.1pt, draw=#1!75!black, fill=#1!6}},
  ol/data/.default=olGray,
  ol/io/.style={trapezium, trapezium left angle=72, trapezium right angle=108,
    trapezium stretches body, draw=#1!75!black, fill=#1!13, line width=0.6pt,
    align=center, inner xsep=2pt, inner ysep=2.6pt, minimum height=6.5mm},
  ol/io/.default=olGray,
  ol/decision/.style={diamond, aspect=2.1, draw=#1!80!black, fill=#1!15,
    line width=0.6pt, align=center, inner sep=1.2pt},
  ol/decision/.default=olOrange,
  ol/terminal/.style={rounded rectangle, draw=olInk, fill=olPaper, line width=0.6pt,
    align=center, inner xsep=4pt, minimum height=6mm},
  ol/endpoint/.style={ol/box, draw=#1!80!black, fill=#1!20, line width=0.9pt},
  ol/endpoint/.default=olWine,
  % groups and panels -------------------------------------------------
  ol/group/.style={draw=#1!70!black, line width=0.5pt, dash pattern=on 2.2pt off 1.4pt,
    rounded corners=3pt, fill=#1!4, inner sep=4pt},
  ol/group/.default=olGray,
  ol/group title/.style={font=\olfigsmall\bfseries, text=#1!75!black, inner sep=1pt},
  ol/group title/.default=olGray,
  ol/panel/.style={draw=olLight, line width=0.5pt, rounded corners=3pt, inner sep=5pt},
  ol/panel label/.style={font=\fontsize{9}{10}\selectfont\bfseries, text=olInk,
    anchor=north west, inner sep=0pt},
  ol/badge/.style={circle, fill=#1, text=white, font=\olfigtiny\bfseries,
    inner sep=0pt, minimum size=3.6mm},
  ol/badge/.default=olInk,
  % connectors ----------------------------------------------------------
  ol/flow/.style={->, draw=olInk, line width=0.7pt, shorten >=0.6pt, shorten <=0.6pt},
  ol/flow strong/.style={ol/flow, line width=1.1pt, draw=#1},
  ol/flow strong/.default=olBlue,
  ol/feedback/.style={ol/flow, draw=olGray, dash pattern=on 2.4pt off 1.6pt},
  ol/link/.style={draw=olGray, line width=0.5pt},
  ol/dim/.style={<->, >={Stealth[length=1.5mm,width=1.2mm]}, draw=olGray, line width=0.45pt},
  ol/brace/.style={decorate, decoration={brace, amplitude=3pt, raise=1pt}, draw=olGray,
    line width=0.5pt},
  ol/guide/.style={draw=olGray!70, line width=0.4pt, dash pattern=on 1.2pt off 1.2pt},
  % text ------------------------------------------------------------------
  ol/note/.style={font=\olfigsmall, text=olGray, align=left, inner sep=1pt},
  ol/edge label/.style={font=\olfigsmall, text=olInk, fill=white, inner sep=1pt,
    rounded corners=0.5pt},
  ol/value/.style={font=\olfigsmall\bfseries, text=#1!85!black, inner sep=1pt},
  ol/value/.default=olInk,
  % grey-safe fills -------------------------------------------------------
  ol/hatch/.style={pattern={Lines[angle=45, distance=2pt, line width=0.35pt]},
    pattern color=#1},
  ol/hatch/.default=olGray,
  ol/dots/.style={pattern={Dots[distance=1.6pt, radius=0.3pt]}, pattern color=#1},
  ol/dots/.default=olGray,
}
\endinput
