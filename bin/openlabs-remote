#!/usr/bin/env bash
# OpenLabs remote compute client (shared file queue, protocol openlabs.remote-compute.v1).
#   bin/openlabs-remote submit --source DIR --cpus N --memory-mib N --timeout-seconds N \
#       [--backend auto|ailab|local] -- COMMAND [ARGS...]
#   (auto, the default: ailab first; overflow to the local container queue when ailab
#   cannot start the job now and it runs here unchanged -- see openlabs.local_compute)
#   bin/openlabs-remote status JOB_ID            (ailab or local job id)
#   bin/openlabs-remote wait JOB_ID [--timeout-seconds N]
# Queue root: $OPENLABS_REMOTE_QUEUE, else /workspace/.openlabs-remote (container)
# or ~/work/projects/.openlabs-remote (WSL). Every operation runs inside the
# OpenLabs resource guard; if you call `python3 -m openlabs.remote_compute`
# directly, wrap it in `bin/openlabs-resource-guard --task-type cpu --` yourself.
set -euo pipefail
SCRIPT=$(readlink -f -- "${BASH_SOURCE[0]}")
ROOT=$(cd -- "$(dirname -- "$SCRIPT")/.." && pwd)
export PYTHONPATH="$ROOT/orchestrator/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$ROOT/bin/openlabs-resource-guard" --task-type cpu -- /usr/bin/python3 -m openlabs.remote_compute "$@"
