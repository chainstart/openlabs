#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
SLICE=openlabs-workers-math.slice

if [[ ${1-} == -- ]]; then shift; fi
if (( $# == 0 )); then
  printf 'Usage: %s -- <command> [args...]\n' "${0##*/}" >&2
  exit 64
fi

# Always retain the repository-wide guard as the outer resource boundary.
if ! rg -q '(^|/)openlabs-workers\.slice(/|$)' /proc/self/cgroup; then
  exec "$ROOT/bin/openlabs-resource-guard" -- "$0" -- "$@"
fi

# Children and ordinary nested OpenLabs guard calls inherit the same math cap.
if rg -q '(^|/)openlabs-workers-math\.slice(/|$)' /proc/self/cgroup; then
  exec "$ROOT/bin/openlabs-resource-guard" -- "$@"
fi

if ! systemctl --user cat "$SLICE" >/dev/null 2>&1; then
  printf 'Math slice is not installed. Run bin/install-math-resource-guard; refusing unbounded work.\n' >&2
  exit 78
fi
systemctl --user start "$SLICE"
# Fail closed if local configuration has drifted from the reserved budget.
if [[ $(systemctl --user show "$SLICE" -p MemoryMax --value) != 19327352832 ]] ||
   [[ $(systemctl --user show "$SLICE" -p MemoryHigh --value) != 17179869184 ]] ||
   [[ $(systemctl --user show "$SLICE" -p MemorySwapMax --value) != 0 ]]; then
  printf 'Math memory limits differ from the approved 16/18 GiB, no-swap budget; refusing work.\n' >&2
  exit 78
fi

unit="openlabs-math-$(date +%Y%m%d-%H%M%S)-$$"
printf 'OpenLabs math guard: shared high=16G max=18G swap=0 tasks=256; physics reservation=16G\n' >&2
exec systemd-run --user --scope --quiet --unit="$unit" --slice="$SLICE" \
  --property=MemoryAccounting=yes --property=MemoryHigh=16G --property=MemoryMax=18G \
  --property=MemorySwapMax=0 --property=TasksAccounting=yes --property=TasksMax=256 \
  --property=OOMPolicy=kill "$ROOT/bin/openlabs-resource-guard" -- "$@"
