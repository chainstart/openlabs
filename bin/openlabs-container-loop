#!/usr/bin/env bash
# Resident tick loop for one OpenLabs instance in a container without systemd.
#
#   bin/openlabs-container-loop [--instance-dir DIR] start     # background, returns at once
#   bin/openlabs-container-loop [--instance-dir DIR] stop [--drain] [--timeout S]
#   bin/openlabs-container-loop [--instance-dir DIR] status
#   bin/openlabs-container-loop [--instance-dir DIR] run       # foreground (same loop)
#   bin/openlabs-container-loop [--instance-dir DIR] cli -- ARGS...   # python -m openlabs ARGS
#
# DIR (default $OPENLABS_INSTANCE_DIR, else /workspace/openlabs/openlabs-instances/cc-sg)
# is made by `python -m openlabs program init-instance --write`. Its instance.env
# (parsed here, never sourced) selects the instance's own runtime database and
# settings file (OPENLABS_INSTANCE, OPENLABS_DATABASE_ROOT, OPENLABS_CONFIG_FILE).
#
# - The whole loop runs inside ONE long-lived bin/openlabs-resource-guard. In
#   Docker the tick starts workers as detached children and the guard
#   (gpu_guard.py, a child subreaper) kills every descendant when its command
#   exits, so a per-tick guard would kill the workers; the tick CLI refuses to
#   run with gpu_guard.py as its direct parent (exit 78). Here the tick's parent
#   is this loop, which is the guard's long-lived child: the supported form.
# - One loop per instance (flock on state/loop.lock).
# - SIGTERM/SIGINT (what `stop` sends): finish the running tick, then exit. The
#   guard then stops in-flight agents; their attempts are retried after restart.
#   `stop --drain` instead waits (no new ticks) until in-flight workers finished.
# - Each tick's report is appended as one JSON line to state/ticks.jsonl.
# - After a successful tick the sleep ends early when a result receipt arrives
#   (but not again for the same unconsumed receipts).
# - After a failed tick (exit != 0, e.g. 69 = Agent network preflight failed)
#   the loop backs off exponentially instead: BASE, 2*BASE, ... capped at MAX,
#   ignoring receipts (a failed tick does not consume them); one successful
#   tick resets it. stop/--drain still end the wait at the next poll.
# - state/loop.log, state/tick.err and state/ticks.jsonl are rotated to *.1 once
#   they exceed OPENLABS_LOOP_LOG_MAX_BYTES (one previous generation kept).
#
# Settings (environment or instance.env): OPENLABS_LOOP_INTERVAL_SECONDS (180),
# OPENLABS_LOOP_TICK_TIMEOUT_SECONDS (10800), OPENLABS_LOOP_POLL_SECONDS (5),
# OPENLABS_LOOP_BACKOFF_BASE_SECONDS (30), OPENLABS_LOOP_BACKOFF_MAX_SECONDS (900),
# OPENLABS_LOOP_LOG_MAX_BYTES (16777216; 0 = never rotate),
# OPENLABS_LOOP_PYTHON (python3), OPENLABS_TEXENV ($HOME/.local/opt/texenv.sh;
# sourced for LaTeX if present, else a warning), OPENLABS_LOOP_MAX_TICKS (0 = no
# limit; drills only).
# OPENLABS_LOOP_AGENT_PROXY (unset = keep the inherited proxy environment): an
# http(s):// proxy URL exported as HTTP(S)_PROXY/ALL_PROXY (both cases) for the
# ticks of `run` and for `cli`, so the Agent preflight and the workers it starts
# use that entrance regardless of who started the loop; NO_PROXY then becomes
# OPENLABS_LOOP_AGENT_NO_PROXY (localhost,127.0.0.1,::1).
set -euo pipefail
SCRIPT=$(readlink -f -- "${BASH_SOURCE[0]}")
CODE=$(cd -- "$(dirname -- "$SCRIPT")/.." && pwd)

instance_dir=${OPENLABS_INSTANCE_DIR:-/workspace/openlabs/openlabs-instances/cc-sg}
if [[ ${1-} == --instance-dir ]]; then
  (($# >= 2)) || { echo "--instance-dir needs a value" >&2; exit 64; }
  instance_dir=$2
  shift 2
fi
command=${1-}
(($#)) && shift
instance_dir=$(readlink -m -- "$instance_dir")
state=$instance_dir/state
env_file=$instance_dir/instance.env

die() { printf 'openlabs-container-loop: %s\n' "$1" >&2; exit "${2:-1}"; }
log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >>"$state/loop.log"; }

load_instance_env() {
  [[ -r $env_file ]] || die "no $env_file; run: python -m openlabs program init-instance --instance-dir $instance_dir --write" 78
  local line name value
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line#"${line%%[![:space:]]*}"}
    [[ -z $line || $line == \#* ]] && continue
    line=${line#export }
    [[ $line == *=* ]] || die "$env_file: expected NAME=VALUE: $line" 65
    name=${line%%=*}
    value=${line#*=}
    [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "$env_file: invalid name $name" 65
    if [[ $value == \"*\" || $value == \'*\' ]]; then value=${value:1:${#value}-2}; fi
    # Instance identity always comes from the file; other settings yield to the
    # caller's environment.
    case $name in
      OPENLABS_INSTANCE|OPENLABS_DATABASE_ROOT|OPENLABS_CONFIG_FILE|OPENLABS_WORKSPACE)
        export "$name=$value" ;;
      *) [[ -n ${!name+x} ]] || export "$name=$value" ;;
    esac
  done <"$env_file"
  [[ -n ${OPENLABS_INSTANCE-} && -n ${OPENLABS_DATABASE_ROOT-} && -n ${OPENLABS_CONFIG_FILE-} ]] ||
    die "$env_file must set OPENLABS_INSTANCE, OPENLABS_DATABASE_ROOT and OPENLABS_CONFIG_FILE" 65
  [[ -f $OPENLABS_CONFIG_FILE ]] || die "missing settings file $OPENLABS_CONFIG_FILE" 78
  export PYTHONPATH="$CODE/orchestrator/src${PYTHONPATH:+:$PYTHONPATH}"
  mkdir -p "$state"
}

loop_pid() {
  local pid
  [[ -r $state/loop.pid ]] || return 1
  pid=$(<"$state/loop.pid")
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
  # Only a live process that still holds the lock is the loop.
  if flock -n "$state/loop.lock" true 2>/dev/null; then return 1; fi
  printf '%s\n' "$pid"
}

backoff_delay() {  # backoff_delay FAILURES BASE MAX -> seconds to wait after FAILURES failed ticks in a row
  local failures=$1 base=$2 max=$3 delay
  ((failures >= 1)) || { echo 0; return; }
  delay=$base
  while ((failures > 1 && delay < max)); do
    delay=$((delay * 2))
    failures=$((failures - 1))
  done
  ((delay > max)) && delay=$max
  echo "$delay"
}

rotate_if_large() {  # rotate_if_large FILE MAX_BYTES: keep one previous generation as FILE.1
  local file=$1 max=$2 size
  ((max > 0)) && [[ -f $file ]] || return 0
  size=$(stat -c %s -- "$file" 2>/dev/null) || return 0
  ((size > max)) && mv -f -- "$file" "$file.1"
  return 0
}

inbox_signature() {  # name, inode and mtime of each waiting result receipt (empty when none)
  local files
  mapfile -t files < <(compgen -G "$1/*.json" | LC_ALL=C sort || true)
  ((${#files[@]})) || return 0
  stat -c '%n %i %y' -- "${files[@]}" 2>/dev/null | tr '\n' ' ' || true
}

apply_agent_proxy() {
  local proxy=${OPENLABS_LOOP_AGENT_PROXY-} no_proxy name label
  [[ -n $proxy ]] || return 0
  [[ $proxy =~ ^https?://[^[:space:]/]+/?$ ]] ||
    die "OPENLABS_LOOP_AGENT_PROXY must be an http(s)://HOST:PORT proxy URL" 65
  no_proxy=${OPENLABS_LOOP_AGENT_NO_PROXY:-localhost,127.0.0.1,::1}
  for name in HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy; do
    export "$name=$proxy"
  done
  export NO_PROXY=$no_proxy no_proxy=$no_proxy
  label=${proxy#*://}; label=${label##*@}; label=${label%/}
  agent_proxy_label=$label  # never the credentials part of the URL
}

inflight_workers() {  # worker processes of this instance (reparented to the guard)
  local guard=$1
  pgrep -P "$guard" -f 'openlabs _worker' 2>/dev/null | wc -l
}

run_loop() {
  local interval=${OPENLABS_LOOP_INTERVAL_SECONDS:-180}
  local tick_timeout=${OPENLABS_LOOP_TICK_TIMEOUT_SECONDS:-10800}
  local poll=${OPENLABS_LOOP_POLL_SECONDS:-5}
  local python=${OPENLABS_LOOP_PYTHON:-python3}
  local max_ticks=${OPENLABS_LOOP_MAX_TICKS:-0}
  local backoff_base=${OPENLABS_LOOP_BACKOFF_BASE_SECONDS:-30}
  local backoff_max=${OPENLABS_LOOP_BACKOFF_MAX_SECONDS:-900}
  local log_max=${OPENLABS_LOOP_LOG_MAX_BYTES:-16777216}
  [[ $backoff_base =~ ^[1-9][0-9]*$ && $backoff_max =~ ^[1-9][0-9]*$ && $log_max =~ ^[0-9]+$ ]] ||
    die "OPENLABS_LOOP_BACKOFF_BASE_SECONDS/_MAX_SECONDS must be positive integers and OPENLABS_LOOP_LOG_MAX_BYTES a non-negative integer" 65
  local texenv=${OPENLABS_TEXENV:-$HOME/.local/opt/texenv.sh}
  local inbox=$OPENLABS_DATABASE_ROOT/inbox/results
  local guard=$PPID
  exec 9>"$state/loop.lock"
  flock -n 9 || die "instance $OPENLABS_INSTANCE already has a running loop" 75
  printf '%s\n' "$$" >"$state/loop.pid"
  rm -f "$state/drain"
  if [[ -r $texenv ]]; then
    # shellcheck disable=SC1090
    set +u; source "$texenv"; set -u
  else
    log "warning: LaTeX environment $texenv not found; paper builds may fail"
  fi
  local stop=""
  trap 'stop=1' TERM INT
  log "loop started pid=$$ guard=$guard instance=$OPENLABS_INSTANCE interval=${interval}s" \
    "backoff=${backoff_base}s..${backoff_max}s agent_proxy=${agent_proxy_label:-inherited}"
  local count=0 started rc report tick_pid failures=0 delay woke_on="" pending
  while [[ -z $stop ]]; do
    rotate_if_large "$state/loop.log" "$log_max"
    rotate_if_large "$state/tick.err" "$log_max"
    rotate_if_large "$state/ticks.jsonl" "$log_max"
    started=$(date -u +%FT%TZ)
    report=$state/last-tick.json
    set +e
    timeout --signal=TERM --kill-after=60 "$tick_timeout" \
      "$python" -m openlabs tick >"$report.tmp" 2>>"$state/tick.err" </dev/null 9>&- &
    tick_pid=$!
    wait "$tick_pid"
    rc=$?
    # A trapped signal interrupts `wait`; the tick itself keeps running to its end.
    while ((rc > 128)) && [[ -n $stop ]]; do
      wait "$tick_pid"
      rc=$?
      ((rc == 127)) && break
    done
    set -e
    mv -f "$report.tmp" "$report"
    "$python" - "$report" "$started" "$rc" >>"$state/ticks.jsonl" 9>&- <<'PY' || log "append failed"
import json, sys
path, started, rc = sys.argv[1], sys.argv[2], int(sys.argv[3])
try:
    with open(path, encoding="utf-8") as handle:
        report = json.load(handle)
except (OSError, ValueError):
    report = None
print(json.dumps({"started_at": started, "exit_code": rc, "report": report},
                 ensure_ascii=False, sort_keys=True))
PY
    count=$((count + 1))
    if ((rc == 0)); then
      log "tick started=$started rc=$rc"
      ((failures > 0)) && log "tick succeeded after $failures failed tick(s); backoff reset"
      failures=0
      delay=$interval
    else
      failures=$((failures + 1))
      delay=$(backoff_delay "$failures" "$backoff_base" "$backoff_max")
      # One line per failed tick; the backoff bounds how often that happens.
      log "tick started=$started rc=$rc failures=$failures; backing off ${delay}s (see tick.err)"
    fi
    if ((max_ticks > 0 && count >= max_ticks)); then break; fi
    # Receipts the last early tick left unconsumed do not wake the loop again.
    if [[ -n $woke_on && $(inbox_signature "$inbox") != "$woke_on" ]]; then woke_on=""; fi
    local waited=0
    while [[ -z $stop ]] && ((waited < delay)); do
      if ((rc == 0)) && compgen -G "$inbox/*.json" >/dev/null; then
        pending=$(inbox_signature "$inbox")
        if [[ $pending != "$woke_on" ]]; then
          woke_on=$pending
          log "result receipt waiting; ticking early"
          break
        fi
      fi
      sleep "$poll" 9>&- &
      wait $! || true
      waited=$((waited + poll))
    done
  done
  if [[ -e $state/drain ]]; then
    log "drain: waiting for $(inflight_workers "$guard") in-flight worker(s)"
    while (($(inflight_workers "$guard") > 0)); do sleep "$poll"; done
  fi
  log "loop stopped (in-flight workers end with the guard)"
  rm -f "$state/loop.pid" "$state/drain"
}

case $command in
  run)
    load_instance_env
    if [[ -z ${OPENLABS_LOOP_GUARDED-} ]]; then
      exec env OPENLABS_LOOP_GUARDED=1 "$CODE/bin/openlabs-resource-guard" --task-type cpu -- \
        "$SCRIPT" --instance-dir "$instance_dir" run
    fi
    apply_agent_proxy
    run_loop
    ;;
  start)
    load_instance_env
    if pid=$(loop_pid); then echo "already running: pid $pid"; exit 0; fi
    nohup setsid "$SCRIPT" --instance-dir "$instance_dir" run \
      >>"$state/loop.out" 2>&1 </dev/null &
    for _ in $(seq 1 100); do
      if pid=$(loop_pid); then echo "started: pid $pid (log $state/loop.log)"; exit 0; fi
      sleep 0.1
    done
    die "loop did not start; see $state/loop.out" 1
    ;;
  stop)
    load_instance_env
    drain="" timeout_s=0
    while (($#)); do
      case $1 in
        --drain) drain=1; shift ;;
        --timeout) timeout_s=$2; shift 2 ;;
        *) die "unknown stop option $1" 64 ;;
      esac
    done
    pid=$(loop_pid) || { echo "not running"; exit 0; }
    [[ -n $drain ]] && : >"$state/drain"
    kill -TERM "$pid"
    echo "stop requested: pid $pid finishes its current tick${drain:+ and waits for in-flight workers}"
    waited=0
    # The lock, not the pid, says whether it still runs (an exited loop may stay
    # a zombie under a parent that does not reap it).
    while ! flock -n "$state/loop.lock" true 2>/dev/null; do
      if ((timeout_s > 0 && waited >= timeout_s)); then die "still running after ${timeout_s}s" 1; fi
      sleep 1
      waited=$((waited + 1))
    done
    echo "stopped"
    ;;
  status)
    load_instance_env
    if pid=$(loop_pid); then echo "running: pid $pid"; else echo "stopped"; fi
    echo "instance: $OPENLABS_INSTANCE  database: $OPENLABS_DATABASE_ROOT"
    echo "settings: $OPENLABS_CONFIG_FILE"
    [[ -e $state/drain ]] && echo "drain requested"
    if [[ -s $state/ticks.jsonl ]]; then
      tail -n 1 "$state/ticks.jsonl" | "${OPENLABS_LOOP_PYTHON:-python3}" -c '
import json, sys
row = json.loads(sys.stdin.read())
report = row.get("report") or {}
keys = ("launched", "enqueued", "ingested", "errors")
counts = {key: len(report.get(key) or []) for key in keys}
print("last tick:", row["started_at"], "exit", row["exit_code"], counts)
'
    fi
    ;;
  cli)
    load_instance_env
    apply_agent_proxy
    [[ ${1-} == -- ]] && shift
    exec "${OPENLABS_LOOP_PYTHON:-python3}" -m openlabs "$@"
    ;;
  *)
    sed -n '2,9p' "$SCRIPT" | sed 's/^# \{0,1\}//' >&2
    exit 64
    ;;
esac
