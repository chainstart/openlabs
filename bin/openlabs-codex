#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
GUARD="$ROOT/bin/openlabs-resource-guard"
WORKSPACE=$(dirname -- "$ROOT")
OPENLABS_PYTHONPATH="$ROOT/orchestrator/src"
if [[ -n ${PYTHONPATH:-} ]]; then
  OPENLABS_PYTHONPATH="$OPENLABS_PYTHONPATH:$PYTHONPATH"
fi

if ! command -v codex >/dev/null 2>&1; then
  printf 'codex is not available on PATH.\n' >&2
  exit 69
fi

exec /usr/bin/env PYTHONPATH="$OPENLABS_PYTHONPATH" /usr/bin/python3 -m openlabs \
  --workspace "$WORKSPACE" network-preflight --exec \
  "$GUARD" -- codex -C "$ROOT" -a never -s danger-full-access "$@"
