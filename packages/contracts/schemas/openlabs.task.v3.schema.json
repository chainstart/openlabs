{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlabs.local/schemas/openlabs.task.v3.schema.json",
  "title": "OpenLabs task v3",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "task_id",
    "attempt_id",
    "campaign_id",
    "lab_id",
    "domain",
    "task_type",
    "objective",
    "output_path",
    "lab_manifest",
    "agent_workspace",
    "run_metadata_path",
    "attempt",
    "agent",
    "resources",
    "budget"
  ],
  "properties": {
    "schema_version": {"const": "openlabs.task.v3"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "campaign_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "lab_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "domain": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "input_path": {"type": ["string", "null"]},
    "output_path": {"type": "string", "minLength": 1},
    "lab_manifest": {"type": "string", "minLength": 1},
    "agent_workspace": {"type": "string", "minLength": 1},
    "run_metadata_path": {"type": "string", "minLength": 1},
    "skill_path": {"type": ["string", "null"]},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_path", "workstream_state_path", "protocol_id"],
      "properties": {
        "config_path": {"type": "string", "minLength": 1},
        "workstream_state_path": {"type": "string", "minLength": 1},
        "protocol_id": {"type": "string", "minLength": 1}
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_session_mode",
        "fresh_session_boundaries"
      ],
      "properties": {
        "default_session_mode": {"enum": ["resume", "fresh"]},
        "fresh_session_boundaries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "role_handoff",
              "text_revision",
              "evidence_remediation",
              "independent_replication",
              "adversarial_review",
              "portfolio_review",
              "route_reselection"
            ]
          }
        }
      }
    },
    "attempt": {"type": "integer", "minimum": 1},
    "agent": {
      "type": "object",
      "required": ["role", "session_mode", "session_id"],
      "properties": {
        "role": {"enum": ["researcher", "experimenter", "writer", "reviewer"]},
        "session_mode": {"enum": ["resume", "fresh"]},
        "session_id": {"type": ["string", "null"]}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_threads", "memory_mib", "scratch_mib"],
      "properties": {
        "cpu_threads": {"type": "integer", "minimum": 1},
        "memory_mib": {"type": "integer", "minimum": 1},
        "scratch_mib": {"type": "integer", "minimum": 1}
      }
    },
    "budget": {
      "type": "object",
      "required": ["wall_seconds"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 1}
      }
    }
  }
}
