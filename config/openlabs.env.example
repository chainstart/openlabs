# Copy to ~/.config/openlabs/env. Keep credentials in the user environment, never here.
# Quote the whole JSON value so systemd preserves the inner double quotes.
# These three Codex profiles must exist locally and must resolve to genuinely different tiers.
OPENLABS_AGENT_COMMAND_CHEAP_JSON='["codex","exec","--profile","openlabs-cheap","-"]'
OPENLABS_AGENT_COMMAND_BALANCED_JSON='["codex","exec","--profile","openlabs-balanced","-"]'
OPENLABS_AGENT_COMMAND_FRONTIER_JSON='["codex","exec","--profile","openlabs-frontier","-"]'
# Resumed sessions retain the model/configuration selected when the session was created.
OPENLABS_AGENT_RESUME_COMMAND_JSON='["codex","exec","resume","{session_id}","-"]'
OPENLABS_AGENT_TIMEOUT_SECONDS=14400
# A lightweight provider HEAD probe is advisory by default because Codex may use
# a different authenticated/proxy transport. The real JSONL startup watchdog is
# authoritative and stops repeated transport-only failures within a bounded time.
OPENLABS_AGENT_PREFLIGHT_TIMEOUT_SECONDS=10
OPENLABS_AGENT_PREFLIGHT_STRICT=false
OPENLABS_AGENT_STARTUP_GRACE_SECONDS=120
OPENLABS_AGENT_TRANSPORT_FAILURE_THRESHOLD=3
# Set only when the command does not expose model_providers.<name>.base_url.
# OPENLABS_AGENT_PREFLIGHT_URL=https://your-provider.example

# Before a manual Codex launch or factory tick, probe the inherited proxy and the
# persisted proxy file. A reachable inherited proxy is written back atomically and
# imported into the systemd user manager; no reachable route means fail closed.
OPENLABS_PROXY_AUTO_SYNC=true
OPENLABS_PROXY_SYNC_SYSTEMD=true
# OPENLABS_PROXY_ENV_FILE=/home/you/.config/environment.d/90-openlabs-proxy.conf

# The second paper reviewer loads the Packy endpoint and credential from this user-owned file.
# Never copy ANTHROPIC_AUTH_TOKEN or ANTHROPIC_API_KEY into this repository file.
OPENLABS_CLAUDE_COMMAND=claude
# OPENLABS_CLAUDE_SETTINGS=/home/you/.claude/settings.json

# systemd may not inherit an nvm/asdf-managed executable path. Set a local PATH if needed.
# PATH=/home/you/.nvm/versions/node/<version>/bin:/usr/local/bin:/usr/bin
