# Copy to ~/.config/openlabs/env. Keep credentials in the user environment, never here.
# Quote the whole JSON value so systemd preserves the inner double quotes.
# These three Codex profiles must exist locally and must resolve to genuinely different tiers.
OPENLABS_AGENT_COMMAND_CHEAP_JSON='["codex","exec","--profile","openlabs-cheap","-c","web_search=\"live\"","-"]'
OPENLABS_AGENT_COMMAND_BALANCED_JSON='["codex","exec","--profile","openlabs-balanced","-c","web_search=\"live\"","-"]'
OPENLABS_AGENT_COMMAND_FRONTIER_JSON='["codex","exec","--profile","openlabs-frontier","-c","web_search=\"live\"","-"]'
# Resumed sessions retain the model/configuration selected when the session was created.
OPENLABS_AGENT_RESUME_COMMAND_JSON='["codex","exec","resume","-c","web_search=\"live\"","{session_id}","-"]'
# Quota-aware routing: six runners, two model families x three tiers. They take
# effect only with matching [runners.<name>] tables in config/openlabs.toml; the
# legacy CHEAP/BALANCED/FRONTIER names above keep working as tier requests.
OPENLABS_AGENT_COMMAND_LEAD_GPT_JSON='["codex","exec","--profile","openlabs-frontier","-m","gpt-6-astra","-c","web_search=\"live\"","-"]'
OPENLABS_AGENT_COMMAND_WORKER_GPT_JSON='["codex","exec","--profile","openlabs-balanced","-m","gpt-6.1-sol","-c","web_search=\"live\"","-"]'
OPENLABS_AGENT_COMMAND_LIGHT_GPT_JSON='["codex","exec","--profile","openlabs-cheap","-c","web_search=\"live\"","-"]'
OPENLABS_AGENT_RESUME_COMMAND_LEAD_GPT_JSON='["codex","exec","resume","-c","web_search=\"live\"","{session_id}","-"]'
OPENLABS_AGENT_RESUME_COMMAND_WORKER_GPT_JSON='["codex","exec","resume","-c","web_search=\"live\"","{session_id}","-"]'
OPENLABS_AGENT_RESUME_COMMAND_LIGHT_GPT_JSON='["codex","exec","resume","-c","web_search=\"live\"","{session_id}","-"]'
# Claude Code (research/writing/decision executor). The request arrives on stdin;
# stream-json+--verbose carries session_id, model, usage and the rate_limit_event
# quota reading. Credentials: the local subscription login (~/.claude/.credentials.json);
# do not set ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN for these
# runners, or the quota readings no longer describe the subscription. The lab runner
# enforces the rest of the policy on every launch and rejects overrides:
#   -p --add-dir <attempt_root> --allowedTools Bash,Read,Edit,Write,MultiEdit,
#   NotebookEdit,Glob,Grep,WebFetch,WebSearch,Skill,TodoWrite,Task,Agent
#   --permission-mode dontAsk --setting-sources project
#   --settings <agent_workspace>/.claude/openlabs-settings.json
#   --output-format stream-json --verbose
# The generated settings carry the result-gate SessionStart/Stop hooks; the process
# runs inside the bubblewrap attempt sandbox (bwrap must be installed). Refused:
# --dangerously-skip-permissions, --allow-dangerously-skip-permissions, any other
# --permission-mode, --bare, --safe-mode, --disable-slash-commands, --settings,
# --setting-sources, and --no-session-persistence for resumable roles.
OPENLABS_AGENT_COMMAND_LEAD_CLAUDE_JSON='["claude","-p","--output-format","stream-json","--verbose","--permission-mode","dontAsk","--model","claude-fable-5-2"]'
OPENLABS_AGENT_COMMAND_WORKER_CLAUDE_JSON='["claude","-p","--output-format","stream-json","--verbose","--permission-mode","dontAsk","--model","claude-opus-5-5"]'
OPENLABS_AGENT_COMMAND_LIGHT_CLAUDE_JSON='["claude","-p","--output-format","stream-json","--verbose","--permission-mode","dontAsk","--model","claude-haiku-5-5"]'
OPENLABS_AGENT_RESUME_COMMAND_LEAD_CLAUDE_JSON='["claude","-p","--resume","{session_id}","--output-format","stream-json","--verbose","--permission-mode","dontAsk","--model","claude-fable-5-2"]'
OPENLABS_AGENT_RESUME_COMMAND_WORKER_CLAUDE_JSON='["claude","-p","--resume","{session_id}","--output-format","stream-json","--verbose","--permission-mode","dontAsk","--model","claude-opus-5-5"]'
OPENLABS_AGENT_RESUME_COMMAND_LIGHT_CLAUDE_JSON='["claude","-p","--resume","{session_id}","--output-format","stream-json","--verbose","--permission-mode","dontAsk","--model","claude-haiku-5-5"]'
# Do not set CLAUDE_CODE_RETRY_WATCHDOG for these runners: it makes Claude wait
# inside the process for a usage-limit reset (undocumented in `claude --help`),
# while the orchestrator already requeues quota failures with backoff.
OPENLABS_AGENT_TIMEOUT_SECONDS=14400
# A lightweight provider HEAD probe is advisory by default because Codex may use
# a different authenticated/proxy transport. The real JSONL startup watchdog is
# authoritative and stops repeated transport-only failures within a bounded time.
OPENLABS_AGENT_PREFLIGHT_TIMEOUT_SECONDS=10
OPENLABS_AGENT_PREFLIGHT_STRICT=false
OPENLABS_AGENT_STARTUP_GRACE_SECONDS=120
OPENLABS_AGENT_TRANSPORT_FAILURE_THRESHOLD=3
# Set only when the command does not expose model_providers.<name>.base_url.
# OPENLABS_AGENT_PREFLIGHT_URL=https://your-provider.example

# Before a manual Codex launch or factory tick, probe the inherited proxy and the
# persisted proxy file. A reachable inherited proxy is written back atomically and
# imported into the systemd user manager; no reachable route means fail closed.
OPENLABS_PROXY_AUTO_SYNC=true
OPENLABS_PROXY_SYNC_SYSTEMD=true
# OPENLABS_PROXY_ENV_FILE=/home/you/.config/environment.d/90-openlabs-proxy.conf

# The second paper reviewer loads the Packy endpoint and credential from this user-owned file.
# Never copy ANTHROPIC_AUTH_TOKEN or ANTHROPIC_API_KEY into this repository file.
OPENLABS_CLAUDE_COMMAND=claude
# OPENLABS_CLAUDE_SETTINGS=/home/you/.claude/settings.json

# systemd may not inherit an nvm/asdf-managed executable path. Set a local PATH if needed.
# PATH=/home/you/.nvm/versions/node/<version>/bin:/usr/local/bin:/usr/bin
